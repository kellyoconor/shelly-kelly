#!/bin/sh
# Helper script for sending proactive Telegram messages with automatic tracking
# Usage: ./send-proactive "message content" [category] [target]

set -eu

if [ $# -lt 1 ]; then
    echo "Usage: ./send-proactive \"message content\" [category] [target]"
    echo ""
    echo "Examples:"
    echo "  ./send-proactive \"Quick body read: readiness looks decent, but sleep was only okay — maybe keep today lighter if your energy feels weird.\" wellness"
    echo "  ./send-proactive \"Worth closing the loop on that thing you were circling earlier if it's still on your mind tonight.\" followup"
    exit 1
fi

MESSAGE="$1"
CATEGORY="${2:-check-in}"
TARGET="${3:-8619914002}"

case "$TARGET" in
    kelly|Kelly|'') TARGET="8619914002" ;;
esac

echo "📱 Sending proactive message..."
echo "📝 Content: $MESSAGE"
echo "🏷️  Category: $CATEGORY"
echo "🎯 Target: $TARGET"
echo ""

# Log the message first to get tracking ID
MESSAGE_ID=$(node /data/workspace/proactive-tracker.cjs log "$MESSAGE" "$CATEGORY" | grep "Logged proactive message:" | cut -d' ' -f4)

if [ -z "$MESSAGE_ID" ]; then
    echo "❌ Failed to log message for tracking"
    exit 1
fi

# Send through the shared Telegram-first Kelly message pipeline
if [ "$TARGET" = "8619914002" ]; then
    echo "🚀 Sending via Telegram through Kelly pipeline..."
    /data/workspace/scripts/proactive-kelly-message.sh "$MESSAGE"
else
    echo "🚀 Sending via Telegram..."
    openclaw message send \
        --channel telegram \
        --to "$TARGET" \
        --message "$MESSAGE"
fi

echo ""
echo "📋 Tracking ID: $MESSAGE_ID"
echo "⏱️  Will check for response in 35 minutes"
echo "💡 Kelly's response will be auto-detected, or you can manually mark:"
echo "    node proactive-tracker.cjs respond $MESSAGE_ID"
